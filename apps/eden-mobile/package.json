{
  "name": "eden-mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "dev:eden": "expo start",
    "build:production": "concurrently \"yarn build:android:production\" \"yarn build:ios:production\"",
    "build:android:staging": "JAVA_HOME=$(/usr/libexec/java_home -v 17) && ENV_JS_FILE=.env.staging && bash ./scripts/build-android-release.sh",
    "build:android:production": "yarn bump:android:version && JAVA_HOME=$(/usr/libexec/java_home -v 17) && ENV_JS_FILE=.env.production && bash ./scripts/build-android-release.sh",
    "build:ios:staging": "ENV_JS_FILE=.env.staging ./scripts/ios-archive.sh",
    "build:ios:production": "ENV_JS_FILE=.env.production ./scripts/ios-archive.sh",
    "bump:android:version": "node ./scripts/bump-android-version.js",
    "clean:ios": "./scripts/ios-clean.sh",
    "clean:android": "rm -rf android/app/build android/app/.cxx android/.gradle .gradle-cache && echo 'Cleaned local Android build artifacts.'"
  },
  "dependencies": {
    "@clerk/clerk-expo": "^2.17.3",
    "@edenlabs/eden-react": "*",
    "@expo/vector-icons": "^15.0.3",
    "@react-navigation/bottom-tabs": "^7.8.6",
    "@react-navigation/native": "^7.1.8",
    "@react-navigation/native-stack": "^7.6.0",
    "expo": "~54.0.20",
    "expo-application": "~7.0.7",
    "expo-auth-session": "^7.0.8",
    "expo-font": "~14.0.9",
    "expo-image-picker": "^17.0.8",
    "expo-network": "~8.0.7",
    "expo-notifications": "^0.32.14",
    "expo-secure-store": "^15.0.7",
    "expo-splash-screen": "~31.0.10",
    "expo-status-bar": "~3.0.8",
    "expo-store-review": "~9.0.8",
    "expo-system-ui": "~6.0.8",
    "expo-web-browser": "^15.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-confirmation-code-field": "^8.0.1",
    "react-native-responsive-screen": "^1.4.2",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "^0.21.0",
    "react-native-webview": "^13.16.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@types/react": "~19.1.0",
    "babel-plugin-module-resolver": "^5.0.0",
    "babel-preset-expo": "~54.0.6",
    "typescript": "^5.9.3",
    "concurrently": "^9.1.2"
  },
  "private": true
}
