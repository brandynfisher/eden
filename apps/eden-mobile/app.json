{
  "expo": {
    "name": "Eden",
    "slug": "eden",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "scheme": "edenmobile",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "art.eden.eden",
      "infoPlist": {
        "NSCameraUsageDescription": "Eden app needs access to your camera to capture photos and videos.",
        "NSPhotoLibraryUsageDescription": "Eden app needs access to your photo library to select images and videos.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "googleServicesFile": "./google-services.json",
      "package": "art.eden.eden",
      "intentFilters": [
        {
          "action": "VIEW",
          "category": ["BROWSABLE", "DEFAULT"],
          "data": [
            {
              "scheme": "edenmobile",
              "host": "oauth",
              "pathPrefix": "/callback"
            }
          ]
        }
      ],
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/SpaceGrotesk-Regular.ttf",
            "./assets/fonts/SpaceGrotesk-Medium.ttf",
            "./assets/fonts/SpaceGrotesk-SemiBold.ttf",
            "./assets/fonts/SpaceGrotesk-Bold.ttf",
            "./assets/fonts/SpaceGrotesk-Light.ttf"
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Eden app needs access to your photo library to select images and videos.",
          "cameraPermission": "Eden app needs access to your camera to capture photos and videos."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "borderRadius": 100,
          "resizeMode": "contain",
          "backgroundColor": "#000",
          "dark": {
            "backgroundColor": "#000"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#000000",
          "sounds": []
        }
      ]
    ],
    "notification": {
      "icon": "./assets/images/icon.png",
      "color": "#000000",
      "iosDisplayInForeground": true,
      "androidMode": "default",
      "androidCollapsedTitle": "#{unread_notifications} new notifications"
    },
    "extra": {
      "eas": {
        "projectId": "27d060c2-c3cb-4908-b1c1-51adaa630d80"
      }
    },
    "owner": "edenart"
  }
}
