{
  "name": "api",
  "version": "0.1.0",
  "description": "Eden.art API",
  "type": "module",
  "scripts": {
    "dev:dummy": "DOTENV_PATH=.env.dummy tsx watch src .env.dummy | pino-pretty --colorize",
    "dev:eden": "DOTENV_PATH=.env.eden tsx watch src .env.eden | pino-pretty --colorize",
    "build": "tsc --outDir build",
    "test": "vitest",
    "start": "node --experimental-specifier-resolution=node build/src",
    "pretest": "npm run build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\""
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "keywords": [
    "nodejs",
    "fastify",
    "typescript"
  ],
  "author": "Eden Labs",
  "license": "MIT",
  "dependencies": {
    "@clerk/clerk-sdk-node": "^4.12.8",
    "@clerk/fastify": "^0.6.11",
    "@edenlabs/config": "*",
    "@edenlabs/eden-sdk": "*",
    "@edenlabs/tsconfig": "*",
    "@fastify/cors": "^8.2.1",
    "@fastify/jwt": "^6.7.1",
    "@fastify/mongodb": "^6.2.0",
    "@fastify/multipart": "^7.6.0",
    "@fastify/rate-limit": "^7.6.0",
    "@immobiliarelabs/fastify-sentry": "^7.1.0",
    "@sinclair/typebox": "^0.23.5",
    "@stripe/stripe-js": "^2.1.0",
    "ajv": "^8.12.0",
    "async": "^3.2.4",
    "aws-sdk": "^2.1454.0",
    "axios": "^1.4.0",
    "axios-retry": "^3.8.0",
    "chromadb": "^1.5.5",
    "dotenv": "^16.0.3",
    "env-schema": "^5.2.0",
    "ethers": "^5.7.2",
    "fastify": "^4.17.0",
    "fastify-disablecache": "^3.1.5",
    "fastify-multipart": "^5.4.0",
    "fastify-plugin": "^3.0.1",
    "fastify-raw-body": "4.1.3",
    "file-type": "^18.3.0",
    "fluent-ffmpeg": "^2.1.2",
    "form-data": "^4.0.0",
    "minio": "^7.1.0",
    "mongoose": "^6.11.1",
    "mongoose-aggregate-paginate-v2": "^1.0.6",
    "mongoose-delete": "^1.0.1",
    "mongoose-paginate-v2": "^1.7.1",
    "mongoose-slug-plugin": "^2.1.0",
    "openai": "^3.2.1",
    "react": "^18.2.0",
    "replicate-js": "github:genekogan/replicate-js",
    "sharp": "^0.32.1",
    "siwe": "^2.1.4",
    "stripe": "^12.18.0",
    "svix": "^1.12.0",
    "uuid": "^9.0.0",
    "vite": "^4.3.5"
  },
  "devDependencies": {
    "@types/async": "^3.2.21",
    "@types/fluent-ffmpeg": "^2.1.21",
    "@types/minio": "^7.0.18",
    "@types/mongoose-aggregate-paginate-v2": "^1.0.9",
    "@types/mongoose-delete": "^0.5.9",
    "@types/node": "^18.16.6",
    "@types/tmp": "^0.2.4",
    "@types/uuid": "^9.0.1",
    "esbuild": "^0.14.54",
    "eslint": "^8.40.0",
    "lint-staged": "^13.2.2",
    "mongodb": "^4.16.0",
    "mongodb-memory-server": "^8.12.2",
    "pino-pretty": "^8.1.0",
    "tsx": "^3.12.7",
    "typescript": "^4.9.5"
  },
  "eslintConfig": {
    "extends": "./.eslintrc.cjs"
  }
}
