{
  "name": "eden-api",
  "version": "0.1.0",
  "description": "Eden.art API",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src .env | pino-pretty --colorize",
    "build": "tsc --outDir build",
    "test": "vitest",
    "start": "node --experimental-specifier-resolution=node build",
    "pretest": "npm run build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\""
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "keywords": [
    "nodejs",
    "fastify",
    "typescript"
  ],
  "author": "Eden Labs",
  "license": "MIT",
  "dependencies": {
    "@eden-labs/eden-sdk": "*",
    "@fastify/cors": "^8.2.1",
    "@fastify/jwt": "^6.7.1",
    "@fastify/mongodb": "^6.2.0",
    "@fastify/multipart": "^7.6.0",
    "@fastify/rate-limit": "^7.6.0",
    "@sinclair/typebox": "^0.23.5",
    "ajv": "^8.12.0",
    "axios": "^1.4.0",
    "dotenv": "^16.0.3",
    "env-schema": "^5.2.0",
    "ethers": "^5.7.2",
    "fastify": "^4.17.0",
    "fastify-plugin": "^3.0.1",
    "file-type": "^18.3.0",
    "form-data": "^4.0.0",
    "minio": "^7.1.0",
    "mongoose": "^6.11.1",
    "openai": "^3.2.1",
    "replicate-js": "github:genekogan/replicate-js",
    "siwe": "^2.1.4",
    "uuid": "^9.0.0",
    "vite": "^4.3.5"
  },
  "devDependencies": {
    "@types/minio": "^7.0.18",
    "@types/node": "^18.16.6",
    "@types/uuid": "^9.0.1",
    "esbuild": "^0.14.54",
    "eslint": "^8.40.0",
    "lint-staged": "^13.2.2",
    "mongodb": "^4.16.0",
    "mongodb-memory-server": "^8.12.2",
    "pino-pretty": "^8.1.0",
    "tsx": "^3.12.7",
    "typescript": "^4.9.5",
    "vitest": "^0.25.8",
    "vitest-mongodb": "^0.0.4"
  }
}
