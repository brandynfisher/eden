meta {
  name: Sessions V3 - Prompt (Stream)
  type: http
  seq: 2
}

post {
  url: {{BASE_URL}}/v3/sessions/prompt/stream
  body: json
  auth: none
}

headers {
  Accept: text/event-stream
  Content-Type: application/json
  X-Api-Key: {{USER_API_KEY}}
}

body:json {
  {
    "session_id": "{{SESSION_ID}}",
    "actor_agent_ids": ["{{AGENT_ID}}"],
    "thinking": false,
    "message": {
      "content": "hello from bruno (stream)",
      "attachments": []
    }
  }
}
