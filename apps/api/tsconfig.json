{
  "extends": "@edenlabs/tsconfig/api.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist",
    "module": "ES2022",
    "moduleResolution": "Node",
    "allowImportingTsExtensions": false,
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "global.d.ts"],
  "exclude": ["node_modules", ".turbo", "coverage", "dist", "tests", "scripts"]
}
