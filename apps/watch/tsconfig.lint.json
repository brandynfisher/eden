{
  "extends": "@edenlabs/tsconfig/media-playground.json",
  "compilerOptions": {
    "jsx": "preserve",
    "target": "es2018",
    "baseUrl": ".",
    "paths": {
      "@/*": ["apps/watch/*"]
    },
    "incremental": false,
    "strictNullChecks": true
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
