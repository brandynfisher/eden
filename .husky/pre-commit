#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

# Generate OpenAPI-derived artifacts before linting
# (ensures generated files get formatted/linted and staged)
echo "🔧 Generating OpenAPI types + MCP tools..."
yarn generate:openapi-types
if [ $? -ne 0 ]; then
  echo "❌ Generation failed. Fix the errors before committing."
  exit 1
fi

# Stage generated artifacts up front so lint-staged sees them
git add apps/api/src/plugins/mcpGeneratedTools.ts packages/eden-sdk-v3/src/generated/sessions-v3.ts

# Run lint-staged for formatting and linting
npx lint-staged

# Re-stage generated files in case lint-staged modified them
git add apps/api/src/plugins/mcpGeneratedTools.ts packages/eden-sdk-v3/src/generated/sessions-v3.ts

# Check TypeScript compilation for apps/api
echo "🔍 Checking TypeScript compilation for apps/api..."
cd apps/api && yarn tsc --noEmit --incremental
if [ $? -ne 0 ]; then
  echo "❌ TypeScript compilation failed in apps/api! Fix the errors before committing."
  exit 1
fi
cd ../..

# Check TypeScript compilation for apps/media-playground
echo "🔍 Checking TypeScript compilation for apps/media-playground..."
cd apps/media-playground && yarn tsc --noEmit --incremental
if [ $? -ne 0 ]; then
  echo "❌ TypeScript compilation failed in apps/media-playground! Fix the errors before committing."
  exit 1
fi
cd ../..

echo "🔍 Checking TypeScript compilation for apps/eden-mobile..."
if [ -d "apps/eden-mobile/node_modules/typescript" ]; then
  cd apps/eden-mobile && yarn tsc --noEmit --incremental
  if [ $? -ne 0 ]; then
    echo "❌ TypeScript compilation failed in apps/eden-mobile! Fix the errors before committing."
    exit 1
  fi
  cd ../..
else
  echo "⚠️  Skipping TypeScript check for apps/eden-mobile (TypeScript not installed)"
fi

echo "✅ All TypeScript checks passed!"
