{
  "name": "eden-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "infra/*"
    ],
    "nohoist": [
      "**/zod",
      "**/zod/**"
    ]
  },
  "scripts": {
    "build": "turbo run build",
    "dev:dummy": "turbo run dev:dummy --parallel",
    "dev:eden": "turbo run dev:eden --parallel",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "prepare": "husky install"
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "^4.1.1",
    "esbuild": "^0.14.10",
    "husky": "^7.0.4",
    "identity-obj-proxy": "^3.0.0",
    "lint-staged": "^15.2.2",
    "msw": "^0.36.3",
    "prettier": "^2.5.1",
    "tsc-files": "^1.1.4",
    "turbo": "*",
    "vite": "^4.3.5",
    "vitest": "^0.32.0",
    "vitest-mongodb": "^0.0.4"
  },
  "lint-staged": {
    "apps/garden/**/*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix --quiet"
    ],
    "apps/api/**/*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix --quiet"
    ],
    "apps/media-playground/**/*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix --quiet"
    ],
    "packages/eden-sdk/**/*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.json": [
      "prettier --write"
    ]
  },
  "packageManager": "yarn@4.4.1",
  "dependencies": {
    "aws-sdk": "^2.1552.0",
    "lodash": "^4.17.21"
  }
}
