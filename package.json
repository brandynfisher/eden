{
  "name": "eden-monorepo",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev:dummy": "turbo run dev:dummy --parallel",
    "dev:eden": "turbo run dev:eden --parallel",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "prepare": "husky install"
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "^4.1.1",
    "esbuild": "^0.14.10",
    "husky": "^7.0.4",
    "identity-obj-proxy": "^3.0.0",
    "lint-staged": "^12.1.3",
    "msw": "^0.36.3",
    "prettier": "^2.5.1",
    "turbo": "*",
    "vite": "^4.3.5",
    "vitest": "^0.25.8",
    "vitest-mongodb": "^0.0.4"
  },
  "lint-staged": {
    "apps/**/*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "packages/sdk/**/*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.json": [
      "prettier --write"
    ]
  },
  "packageManager": "yarn@1.22.19"
}
