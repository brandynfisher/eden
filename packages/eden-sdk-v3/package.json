  "license": "MIT",
  "files": [
    "dist"
  ],
  "dependencies": {
    "openapi-fetch": "^0.10.1"
  },
  "devDependencies": {
    "microbundle": "^0.15.1",
    "openapi-typescript": "^6.7.6",
    "typescript": "^5"
  }
}
